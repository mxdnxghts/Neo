<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
        <Nullable>disable</Nullable>
        <LangVersion>preview</LangVersion>
        <GenerateDocumentationFile>True</GenerateDocumentationFile>
        <RepositoryUrl>https://github.com/mxdnxghts/Neo</RepositoryUrl>
        <NeutralLanguage>en</NeutralLanguage>
        <Authors>mxdnxghts</Authors>
        <Company>mxdnxghts</Company>
        <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
        <TargetFrameworks>net10.0-windows;netstandard2.0</TargetFrameworks>
        <PackageVersion>1.0.0-stable</PackageVersion>
        <AssemblyVersion></AssemblyVersion>
        <FileVersion>1.0.0-stable</FileVersion>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <DebugType>portable</DebugType>
        <DebugSymbols>true</DebugSymbols>
        <PlatformTarget>AnyCPU</PlatformTarget>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0-windows|AnyCPU'">
        <WarningLevel>7</WarningLevel>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0-windows|AnyCPU'">
        <WarningLevel>7</WarningLevel>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Dapper" Version="2.1.66" />
        <PackageReference Include="FluentResults" Version="4.0.0" />
        <PackageReference Include="LiveXAML" Version="2.1.73" />
        <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.1" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.1" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.1" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.1" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.2" />
        <PackageReference Include="Microsoft.Maui.Graphics" Version="10.0.20" />
        <PackageReference Include="Npgsql" Version="5.0.18" />
        <PackageReference Include="SkiaSharp" Version="3.119.1" />
        <PackageReference Include="SkiaSharp.Extended" Version="3.0.0" />
        <PackageReference Include="SkiaSharp.Svg" Version="1.60.0" />
        <PackageReference Include="System.Data.SqlClient" Version="4.9.0" />
        <PackageReference Include="System.IO" Version="4.3.0" />
        <PackageReference Include="Xam.Plugin.Media" Version="6.0.2" />
        <PackageReference Include="Xamarin.CommunityToolkit" Version="2.0.6" />
        <PackageReference Include="Xamarin.Forms" Version="5.0.0.2662" />
        <PackageReference Include="Xamarin.Essentials" Version="1.8.1" />
        <PackageReference Include="Xamarin.Tesseract" Version="0.3.4" />
        <PackageReference Include="XLabs.IoC" Version="2.3.0-pre05" />
        <PackageReference Include="XLabs.IoC.TinyIOC" Version="2.3.0-pre05" />
        <PackageReference Include="XLabs.Platform" Version="2.3.0-pre05" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="$(SolutionDir)Dependencies\**\*">
            <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
            <Visible>false</Visible>
        </Content>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Data\" />
    </ItemGroup>
</Project>
