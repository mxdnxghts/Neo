<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:NeoAndroidApp"
             xmlns:models="clr-namespace:NeoAndroidApp.Models"
             xmlns:converters="clr-namespace:NeoAndroidApp.Converters"
             xmlns:viewmodels="clr-namespace:NeoAndroidApp.ViewModels"
             x:Class="NeoAndroidApp.Views.MatrixBuilderPage"
             x:DataType="viewmodels:MatrixBuilderViewModel"
             Title="Matrix Builder">

    <ContentPage.Resources>
        <converters:IsValidDoubleConverter x:Key="IsValidDoubleConverter" />
        <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        <converters:StringIsEmptyConverter x:Key="StringIsEmptyConverter" />

        <!-- Light theme colors -->
        <Color x:Key="CardBackgroundLight">#FFFFFF</Color>
        <Color x:Key="CardBorderLight">#CCCCCC</Color>
        <Color x:Key="EntryBackgroundLight">#E8E8E8</Color>
        <Color x:Key="ErrorBackgroundLight">#FFF5F5</Color>
        <Color x:Key="ErrorBorderLight">#DC3545</Color>
        <Color x:Key="ErrorTextLight">#DC3545</Color>
        <Color x:Key="SuccessBackgroundLight">#F0FFF4</Color>
        <Color x:Key="SuccessBorderLight">#28A745</Color>
        <Color x:Key="SuccessTextLight">#155724</Color>
        <Color x:Key="PrimaryTextLight">#000000</Color>

        <!-- Dark theme colors -->
        <Color x:Key="CardBackgroundDark">#2D2D2D</Color>
        <Color x:Key="CardBorderDark">#404040</Color>
        <Color x:Key="EntryBackgroundDark">#505050</Color>
        <Color x:Key="ErrorBackgroundDark">#3D1F1F</Color>
        <Color x:Key="ErrorBorderDark">#B71C1C</Color>
        <Color x:Key="ErrorTextDark">#FFCDD2</Color>
        <Color x:Key="SuccessBackgroundDark">#1B3320</Color>
        <Color x:Key="SuccessBorderDark">#2E7D32</Color>
        <Color x:Key="SuccessTextDark">#C8E6C9</Color>
        <Color x:Key="PrimaryTextDark">#FFFFFF</Color>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="20">

            <!-- Headers -->
            <Frame BorderColor="{AppThemeBinding Light={StaticResource CardBorderLight}, Dark={StaticResource CardBorderDark}}"
                   Padding="15"
                   CornerRadius="10"
                   BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}">
                <HorizontalStackLayout Spacing="10" HorizontalOptions="Fill">
                    <Label Text="Coef." WidthRequest="50" FontAttributes="Bold" HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"/>
                    <HorizontalStackLayout Spacing="5" HorizontalOptions="FillAndExpand">
                        <BindableLayout.ItemsSource>
                            <Binding Path="VariableLabels" />
                        </BindableLayout.ItemsSource>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Label Text="{Binding .}"
                                       WidthRequest="60"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"/>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                    <Label Text="=" WidthRequest="20" FontAttributes="Bold" HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"/>
                    <Label Text="Const." WidthRequest="60" FontAttributes="Bold" HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"/>
                    <Label WidthRequest="40"/>
                </HorizontalStackLayout>
            </Frame>

            <!-- Equations list -->
            <CollectionView ItemsSource="{Binding Equations}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:EquationRow">
                        <Frame BorderColor="{AppThemeBinding Light={StaticResource CardBorderLight}, Dark={StaticResource CardBorderDark}}"
                               Padding="10"
                               Margin="0,5"
                               CornerRadius="8"
                               BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}">
                            <HorizontalStackLayout Spacing="10" HorizontalOptions="Fill">
                                <!-- Equation terms: coefficient + variable (e.g., "1x + 2y") -->
                                <HorizontalStackLayout Spacing="2" HorizontalOptions="FillAndExpand">
                                    <BindableLayout.ItemsSource>
                                        <Binding Path="TermItems" />
                                    </BindableLayout.ItemsSource>
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:EquationTermItem">
                                            <HorizontalStackLayout Spacing="2" HorizontalOptions="Center">
                                                <!-- Coefficient entry -->
                                                <Entry Text="{Binding Coefficient}"
                                                       Keyboard="Numeric"
                                                       WidthRequest="50"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center"
                                                       BackgroundColor="{AppThemeBinding Light={StaticResource EntryBackgroundLight}, Dark={StaticResource EntryBackgroundDark}}"
                                                       TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}">
                                                    <Entry.Triggers>
                                                        <DataTrigger TargetType="Entry"
                                                                     Binding="{Binding Coefficient, Converter={StaticResource IsValidDoubleConverter}}"
                                                                     Value="False">
                                                            <Setter Property="BackgroundColor" Value="#FFDDDD"/>
                                                            <Setter Property="TextColor" Value="Red"/>
                                                        </DataTrigger>
                                                    </Entry.Triggers>
                                                </Entry>
                                                <!-- Variable label (x1, x2, etc.) -->
                                                <Label Text="{Binding VariableLabel}"
                                                       FontSize="14"
                                                       VerticalOptions="Center"
                                                       TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"/>
                                                <!-- Plus sign between terms (not after last) -->
                                                <Label Text="+"
                                                       FontSize="14"
                                                       VerticalOptions="Center"
                                                       TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label"
                                                                     Binding="{Binding IsLast}"
                                                                     Value="True">
                                                            <Setter Property="IsVisible" Value="False"/>
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </HorizontalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </HorizontalStackLayout>

                                <!-- Equals sign -->
                                <Label Text="="
                                       VerticalOptions="Center"
                                       FontSize="18"
                                       WidthRequest="25"
                                       HorizontalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"/>

                                <!-- Constant entry -->
                                <Entry Text="{Binding Constant}"
                                       Keyboard="Numeric"
                                       WidthRequest="70"
                                       BackgroundColor="{AppThemeBinding Light={StaticResource EntryBackgroundLight}, Dark={StaticResource EntryBackgroundDark}}"
                                       TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
                                       HorizontalOptions="Center">
                                    <Entry.Triggers>
                                        <DataTrigger TargetType="Entry"
                                                     Binding="{Binding Constant, Converter={StaticResource IsValidDoubleConverter}}"
                                                     Value="False">
                                            <Setter Property="BackgroundColor" Value="#FFDDDD"/>
                                            <Setter Property="TextColor" Value="Red"/>
                                        </DataTrigger>
                                    </Entry.Triggers>
                                </Entry>

                                <!-- Delete button -->
                                <Button Text="✖"
                                        TextColor="White"
                                        BackgroundColor="#DC3545"
                                        CornerRadius="20"
                                        WidthRequest="40"
                                        HeightRequest="40"
                                        FontSize="16"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MatrixBuilderViewModel}}, Path=RemoveEquationCommand}"
                                        CommandParameter="{Binding .}"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Add equation button -->
            <Button Text="+ Add Equation"
                    Command="{Binding AddEquationCommand}"
                    BackgroundColor="#28A745"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="50"
                    FontSize="16"/>

            <!-- Solve button -->
            <Button Text="Solve System"
                    Command="{Binding SolveCommand}"
                    IsEnabled="{Binding IsValid}"
                    BackgroundColor="#007BFF"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="50"
                    FontSize="18"
                    FontAttributes="Bold"/>

            <!-- Activity indicator for busy state -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="#007BFF"
                               HeightRequest="50"/>

            <!-- Error message -->
            <Frame BorderColor="{AppThemeBinding Light={StaticResource ErrorBorderLight}, Dark={StaticResource ErrorBorderDark}}"
                   BackgroundColor="{AppThemeBinding Light={StaticResource ErrorBackgroundLight}, Dark={StaticResource ErrorBackgroundDark}}"
                   Padding="15"
                   CornerRadius="10"
                   IsVisible="{Binding HasError}">
                <Label Text="{Binding ErrorMessage}"
                       TextColor="{AppThemeBinding Light={StaticResource ErrorTextLight}, Dark={StaticResource ErrorTextDark}}"
                       FontSize="14"
                       LineBreakMode="WordWrap"/>
            </Frame>

            <!-- Result -->
            <Frame BorderColor="{AppThemeBinding Light={StaticResource SuccessBorderLight}, Dark={StaticResource SuccessBorderDark}}"
                   BackgroundColor="{AppThemeBinding Light={StaticResource SuccessBackgroundLight}, Dark={StaticResource SuccessBackgroundDark}}"
                   Padding="20"
                   CornerRadius="10"
                   IsVisible="{Binding ResultText, Converter={StaticResource StringIsEmptyConverter}, ConverterParameter=inverse}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Solution:"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource SuccessTextLight}, Dark={StaticResource SuccessTextDark}}"/>
                    <Label Text="{Binding ResultText}"
                           FontSize="16"
                           LineBreakMode="WordWrap"
                           TextColor="{AppThemeBinding Light={StaticResource SuccessTextLight}, Dark={StaticResource SuccessTextDark}}"/>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
